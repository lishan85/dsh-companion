{
  "name": "dsh-companion",
  "version": "0.1.0",
  "description": "Long-term companion for DeepSeek Harness: raw-turn SQLite log, CJK FTS5 recall, and budgeted first-person injection",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "companion",
    "sqlite",
    "fts5"
  ],
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lishan85/dsh-companion.git"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "dsh-ltm": "bin/dsh-ltm.mjs"
  },
  "files": [
    "dist",
    "bin",
    "cordis.patch.yml"
  ],
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.6 <0.2.0 || 0.2.1-rc.1 || 0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.2.0 || 0.2.1-rc.1 || 0.2.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^26.2.0",
    "tsdown": "^0.15.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "optionalDependencies": {
    "@huggingface/tokenizers": "0.2.0"
  }
}
